{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Vyoma/agent-economics-lab/main/templates/agent-decision-record.schema.json",
  "title": "Agent Decision Record",
  "description": "One auditable decision to scale, assist, stop, or refuse judgment on an agent workload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "workload",
    "decision",
    "claims",
    "evidence",
    "counterfactual",
    "cost_boundary",
    "uncertainty",
    "controls",
    "reproduction",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "agent-decision-record/v1" },
    "record_id": { "$ref": "#/$defs/nonEmptyString" },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit_of_work", "owner", "population", "observation_window"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "unit_of_work": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "population": { "$ref": "#/$defs/nonEmptyString" },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/nonEmptyString" },
            "end": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "issued", "rationale", "expires_on", "rollback_trigger"],
      "properties": {
        "requested": { "enum": ["SCALE", "ASSIST", "STOP"] },
        "issued": { "$ref": "#/$defs/decision" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "expires_on": { "$ref": "#/$defs/nonEmptyString" },
        "rollback_trigger": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_id", "evidence_digest", "decision_contract_digest", "artifacts"],
      "properties": {
        "source_manifest_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_digest": { "$ref": "#/$defs/sha256" },
        "decision_contract_digest": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "role", "sha256"],
            "properties": {
              "uri": { "$ref": "#/$defs/nonEmptyString" },
              "role": { "$ref": "#/$defs/nonEmptyString" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_ref", "why_comparable"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
        "why_comparable": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cost_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "included", "excluded", "allocation_notes"],
      "properties": {
        "currency": { "$ref": "#/$defs/nonEmptyString" },
        "included": { "$ref": "#/$defs/nonEmptyStringArray" },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allocation_notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "known_missing_evidence", "non_claims"],
      "properties": {
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "known_missing_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "non_claims": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_before_next_mode", "human_escalation", "runtime_caps"],
      "properties": {
        "required_before_next_mode": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "human_escalation": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_caps": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "environment", "revision"],
      "properties": {
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_date", "reviewers", "signed_off"],
      "properties": {
        "review_date": { "$ref": "#/$defs/nonEmptyString" },
        "reviewers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "signed_off": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "enum": ["INCOMPLETE", "SCALE", "ASSIST", "STOP"] },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "threshold",
        "check_id",
        "required",
        "if_absent",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
        "threshold": { "$ref": "#/$defs/nonEmptyString" },
        "observed": { "$ref": "#/$defs/nonEmptyString" },
        "missing_reason": { "$ref": "#/$defs/nonEmptyString" },
        "check_id": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "if_absent": { "$ref": "#/$defs/decision" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "INCOMPLETE" } } },
          "then": { "required": ["missing_reason"] },
          "else": {
            "required": ["observed"],
            "properties": { "evidence_refs": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "required": { "const": true } } },
          "then": { "properties": { "if_absent": { "const": "INCOMPLETE" } } }
        }
      ]
    }
  }
}
