{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Vyoma/agent-economics-lab/main/templates/agent-decision-record.schema.json",
  "title": "Agent Decision Record",
  "description": "One reproducible decision to scale, assist, stop, or refuse judgment on an agent workload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "workload",
    "decision",
    "claims",
    "evidence",
    "assurance",
    "counterfactual",
    "cost_boundary",
    "uncertainty",
    "controls",
    "reproduction",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "agent-decision-record/v1" },
    "record_id": { "$ref": "#/$defs/nonEmptyString" },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit_of_work", "owner", "population", "observation_window"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "unit_of_work": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "population": { "$ref": "#/$defs/nonEmptyString" },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/isoDate" },
            "end": { "$ref": "#/$defs/isoDate" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "issued", "rationale", "expires_on", "rollback_trigger"],
      "properties": {
        "requested": { "enum": ["SCALE", "ASSIST", "STOP"] },
        "issued": { "$ref": "#/$defs/decision" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "expires_on": { "$ref": "#/$defs/isoDate" },
        "rollback_trigger": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_id",
        "evidence_digest",
        "decision_contract_digest",
        "bundle_ref",
        "enabled_checks",
        "required_coverage",
        "artifacts"
      ],
      "properties": {
        "source_manifest_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_digest": { "$ref": "#/$defs/sha256" },
        "decision_contract_digest": { "$ref": "#/$defs/sha256" },
        "bundle_ref": { "$ref": "#/$defs/relativePath" },
        "enabled_checks": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required_coverage": { "$ref": "#/$defs/nonEmptyStringArray" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "role", "sha256"],
            "properties": {
              "uri": { "$ref": "#/$defs/relativePath" },
              "role": { "$ref": "#/$defs/nonEmptyString" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_entry_point",
        "audit_as_of",
        "audit_assessable",
        "audit_grounds",
        "label_source",
        "attestation_refs",
        "delegation",
        "fail_closed_conformance"
      ],
      "properties": {
        "gate_entry_point": { "const": "agent_economics.audit.decide" },
        "audit_as_of": { "$ref": "#/$defs/isoDate" },
        "audit_assessable": { "type": "boolean" },
        "audit_grounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "label_source": { "$ref": "#/$defs/nonEmptyString" },
        "attestation_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "delegation": { "$ref": "#/$defs/delegation" },
        "fail_closed_conformance": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["audit_assessable"],
            "properties": { "audit_assessable": { "const": true } }
          },
          "then": { "properties": { "audit_grounds": { "maxItems": 0 } } },
          "else": { "properties": { "audit_grounds": { "minItems": 1 } } }
        }
      ]
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_ref", "why_comparable"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_ref": { "$ref": "#/$defs/relativePath" },
        "why_comparable": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cost_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "included", "excluded", "allocation_notes"],
      "properties": {
        "currency": { "$ref": "#/$defs/nonEmptyString" },
        "included": { "$ref": "#/$defs/nonEmptyStringArray" },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allocation_notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "known_missing_evidence", "non_claims"],
      "properties": {
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "known_missing_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "non_claims": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_before_next_mode", "human_escalation", "runtime_caps"],
      "properties": {
        "required_before_next_mode": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "human_escalation": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_caps": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "environment", "revision"],
      "properties": {
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_date", "reviewers", "signed_off"],
      "properties": {
        "review_date": { "$ref": "#/$defs/isoDate" },
        "reviewers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "signed_off": { "const": true }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": ["INCOMPLETE", "SCALE", "ASSIST", "STOP"]
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "closure", "unaccounted"],
      "properties": {
        "status": {
          "enum": ["COMPLETE", "INCOMPLETE", "NOT_APPLICABLE"]
        },
        "basis": {
          "enum": ["COST", "COUNT", "NOT_APPLICABLE"]
        },
        "closure": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ]
        },
        "unaccounted": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "NOT_APPLICABLE" } }
          },
          "then": {
            "properties": {
              "basis": { "const": "NOT_APPLICABLE" },
              "closure": { "type": "null" },
              "unaccounted": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "COMPLETE" } }
          },
          "then": {
            "properties": {
              "basis": { "enum": ["COST", "COUNT"] },
              "closure": { "type": "number" },
              "unaccounted": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "INCOMPLETE" } }
          },
          "then": {
            "properties": {
              "basis": { "enum": ["COST", "COUNT"] },
              "closure": { "type": "number" },
              "unaccounted": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "threshold",
        "check_id",
        "required",
        "if_absent",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
        "threshold": { "$ref": "#/$defs/nonEmptyString" },
        "observed": { "$ref": "#/$defs/nonEmptyString" },
        "missing_reason": { "$ref": "#/$defs/nonEmptyString" },
        "check_id": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "if_absent": { "$ref": "#/$defs/decision" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "INCOMPLETE" } }
          },
          "then": { "required": ["missing_reason"] },
          "else": {
            "required": ["observed"],
            "properties": { "evidence_refs": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "required": ["required"],
            "properties": { "required": { "const": true } }
          },
          "then": {
            "properties": { "if_absent": { "const": "INCOMPLETE" } }
          }
        }
      ]
    }
  }
}
